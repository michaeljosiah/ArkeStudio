<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(VoiceLabBuildRoot)/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <BaseOutputPath>$(VoiceLabBuildRoot)/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**;.build/**</DefaultItemExcludes>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>
