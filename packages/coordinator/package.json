{
  "name": "@arke-studio/coordinator",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "The application's domain layer, embedded in the Electron main process: WebSocket transport with sequenced frames, read model, append-only change log, world provider, and the generic child-process supervisor (SPEC-001 §2.6).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "tsx src/dev-preflight.ts && node scripts/build-media-worker.mjs && tsx src/dev.ts",
    "server": "node scripts/build-media-worker.mjs && tsx src/server-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@arke-studio/adapter-claude": "*",
    "@arke-studio/adapter-codex": "*",
    "@arke-studio/adapter-opencode": "*",
    "@arke-studio/contracts": "*",
    "@arke-studio/providers": "*",
    "@arke-studio/voice": "*",
    "better-sqlite3": "^12.11.1",
    "fontkit": "2.0.4",
    "pdfjs-dist": "5.4.624",
    "pdfkit": "0.20.2",
    "ws": "^8.18.0",
    "yaml": "^2.6.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/fontkit": "2.0.9",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "0.17.6",
    "@types/ws": "^8.5.12",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
