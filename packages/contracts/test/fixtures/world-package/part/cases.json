{
  "note": "SPEC-058 R-46: the part cases both readers run, Arke Player arke_world (Dart) and ArkeStudio contracts (TypeScript). Each file is a world.json. \"part\" lists what an ok case reads: follows, number, and the schedule's day and next.",
  "days": [
    "monday",
    "tuesday",
    "wednesday",
    "thursday",
    "friday",
    "saturday",
    "sunday",
    "daily"
  ],
  "cases": [
    {
      "file": "part.json",
      "reader": "manifest",
      "expect": "ok",
      "part": {
        "follows": "2026-10-22",
        "number": 1,
        "day": "friday",
        "next": "2026-11-06"
      }
    },
    {
