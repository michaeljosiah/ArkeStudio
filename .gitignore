# Raw pasted/scratch source material — large binaries, not part of the design system
design-system/uploads/

# Tool-generated thumbnail cache
.thumbnail

# Dependencies and build output
node_modules/
dist/
release/
# electron-builder's configured output is `release/`, but a packaging run pointed anywhere else
# lands beside it — `release-local/` is a local build, several hundred MB of win-unpacked.
# Globbed rather than named: `release-fresh/` was created to route around a wedged
# `win-unpacked` and was very nearly committed, all 280MB of it.
release-*/
apps/desktop/build-resources/
.runtime-work/
# Where a runtime prepare parks the previous staged copy while the new one moves in. Empty
# except during that swap, and only left behind if the swap itself died mid-move.
apps/desktop/.runtime-previous/
*.tsbuildinfo

# Git worktrees checked out inside the repo. Committing one would commit a nested checkout —
# `.claude/worktrees/` is already excluded locally; this covers the hand-made ones.
*-worktree/

# Reports generated by the branch/worktree pruning script.
.claude/*-branch-manifest.txt
.claude/deleted-branches-*.txt
.claude/pruned-*.txt

# Local dev scratch (dev coordinator change log, etc.)
.dev/

# Per-machine env overrides — VITE_ARKE_WS when a dev coordinator moved off 8791, and
# anything else local. Never the committed configuration.
.env.local
.env.*.local

# Local system documentation — generated for this machine, not shipped.
docs/system/

# Story bibles written by hand for reference — working documents, not shipped.
docs/example/
